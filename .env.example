# Postgres (Supabase). Aplikacija ide kroz POOLED string; pgbouncer=true je
# obavezan za Prismu, inace prepared statements pucaju u transaction modu.
DATABASE_URL="postgresql://postgres.<ref>:<lozinka>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Direktna veza, samo za `prisma db push` i migracije. DDL kroz pooler ne ide.
DIRECT_URL="postgresql://postgres:<lozinka>@db.<ref>.supabase.co:5432/postgres?sslmode=require"

# Serverski kljuc za HMAC kodova i potpisivanje tokena.
# U produkciji: dugacka slucajna vrednost iz secret managera, nikad u repou.
CODE_HMAC_SECRET="promeni-me"
TOKEN_SECRET="promeni-me"

# Privatni store za originale i pecene derivate. Van public/.
# STORAGE_ROOT="./storage"

ADMIN_TOKEN="promeni-me"
